frontlet:AgeEntity a owl:Class ;
    skos:definition "Super class dealing with migrant age"@en,
        "Super classe gérant l'âge d'un migrant"@fr ;
    skos:prefLabel "Age entity"@en,
        "Entité âge"@fr .

frontlet:DeathInjury a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Event consisting in the death or the injury of a migrant crossing a border"@en,
        "Evènement consistant à la blessure ou la mort d'un migrant lors du passage d'une frontière."@fr ;
    skos:prefLabel "Death injury"@en,
        "Mort blessure"@fr .

frontlet:Event a owl:Class ;
    skos:definition "A life moment of a migrant during its journey"@en,
        "Un moment de la vie d'un migrant durant son trajet."@fr ;
    skos:prefLabel "Event"@en,
        "Evènement"@fr .

frontlet:OfficialDocument a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "Official document attesting the passage or the death of a migrant"@en,
        "Document officiel attestant du passage ou de la mort d'un migrant"@fr ;
    skos:prefLabel "Official document"@en,
        "Document officiel"@fr .

frontlet_data:migrant_CollectiveEvent_114 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 114" ;
    frontlet:hasNarrative "Sinks near Cesme small raft live in Greece, 3 killed (Dec 7, 2001)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_128 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 128" ;
    frontlet:hasNarrative "Trying to enter illegally into Turkey from the border with Syria, the Turkish police opened fire, 3 deaths (Mar 5, 2002)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_132 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 132" ;
    frontlet:hasNarrative "Abandoned in a parking lot in Catalca, near Istanbul, the bodies of three men suffocated hidden in the truck where they traveled to Greece (Apr 14, 2002)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_175 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 175" ;
    frontlet:hasNarrative "Minefield in Evros, greek-turkish border. An explosion ago 2 dead and one wounded. They tried to enter illegally in Greece (Jan 7, 2003)" ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:migrant_CollectiveEvent_187 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 187" ;
    frontlet:hasNarrative "1 dead, 1 injured on antipersonnel minefields in Evros, on the northeastern border with Turkey (Mar 26, 2003)" ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:migrant_CollectiveEvent_189 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 189" ;
    frontlet:hasNarrative "Found the bodies of three men drowned the day before in the waters of Tuineje, Fuerteventura, in the Canary Islands (Jun 3, 2003)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_195 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 195" ;
    frontlet:hasNarrative "Off Cap Bon sinking boat heading towards Lampedusa, 3 dead, 35 survivors (Jun 29, 2003)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_204 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 204" ;
    frontlet:hasNarrative "Hidden in containers of a cargo ship departed from Guinea, plunge into the sea arrived in the port of Le Havre, 3 drowned (Oct 1, 2003)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_259 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 259" ;
    frontlet:hasNarrative "Sink a small boat near Samos. 3 dead (Dec 11, 2004)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_267 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 267" ;
    frontlet:hasNarrative "died crossing the Oder/Neisse border (suicide possible). German police did not record the precise date." ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_268 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 268" ;
    frontlet:hasNarrative "A ship bound for Greece tips off the Turkish coast. 2 dead, 1 missing (Jan 3, 2005)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_270 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 270" ;
    frontlet:hasNarrative "Sink a small boat to the island Samos in the Aegean Sea live. 3 dead, 13 survivors were arrested (Jan 10, 2005)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_291 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 291" ;
    frontlet:hasNarrative "3 drowned along the river Oder-Neisse border Poland-Germany. Recovered at the same time the body of a man found dead on the border between Germany, Austria and the Czech Republic (Jun 16, 2005)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_296 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 296" ;
    frontlet:hasNarrative "Three men died poisoned by the fumes of the cargo ship on which they traveled to Denmark hidden (Jun 19, 2005)" ;
    frontlet:totalDeadAndMissing 3 .

