frontlet_data:migrant_callEvent_733_1 a frontlet:Call,
        frontlet:IndividualEvent ;
    frontlet:group frontlet_data:migrant_CollectiveEvent_733 ;
    frontlet:hasComment "Are still missing at sea, twenty days after their departure from Libya, two boats of the Eritrean direct to Lampedusa. First there were 335 passengers and 160 on the second. Both had asked for help by calling the Eritrean community in Rome. But they never arrived at their destination. Neither in Italy nor in Malta, nor have returned to Libya (Apr 13, 2011) | Drowned | lampedusa | Libya | Repubblica | http://fortresseurope.blogspot.com/2011/04/pantelleria-due-morte-un-disperso-e-le.html | Libya | Italy",
        "Detected event type: Call" ;
    temp:before frontlet_data:migrant_MissingEvent_733_1 .

