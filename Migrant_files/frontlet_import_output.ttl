frontlet_data:migrant_CollectiveEvent_152 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 152" ;
    frontlet:hasNarrative "Landing in Tarifa. At 150 meters from the shore the two rails of the boat force passengers to dive and continue swimming. At least 13 people die drowned (Aug 2, 2002)" ;
    frontlet:totalDeadAndMissing 13 .

frontlet_data:migrant_CollectiveEvent_188 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 188" ;
    frontlet:hasNarrative "Intercepted boat adrift for 14 days, 130 miles to the south of the island of El Hierro, in the Canary Islands. Passengers speak of 12 died of starvation. Their bodies were thrown overboard by his companions. A man dies during rescue (Mar 31, 2003)" ;
    frontlet:totalDeadAndMissing 13 .

frontlet_data:migrant_CollectiveEvent_225 a frontlet:CollectiveEvent ;
