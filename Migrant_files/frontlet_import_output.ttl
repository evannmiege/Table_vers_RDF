frontlet_data:migrant_CollectiveEvent_100 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 100" ;
    frontlet:hasNarrative "30 people hidden in a mercantile turkish flow into the sea off the coast of Vlora, 4 drowned (Sep 17, 2001)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_117 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 117" ;
    frontlet:hasNarrative "Livorno suffocated in trucks where they were hidden, 4 dead (Dec 12, 2001)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_126 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 126" ;
    frontlet:hasNarrative "4 drowned in a shipwreck in front of the coast of Tarifa (Feb 13, 2002)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_140 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 140" ;
    frontlet:hasNarrative "Lecce: smugglers spotted by the Guardia di Finanza, throwing 40 people overboard and stab two men who resist. 4 drowned (Jun 8, 2002)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_180 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 180" ;
    frontlet:hasNarrative "4 more bodies found in the waters of Fuerteventura, probably part of the 14 victims of the sinking of 16 January (Jan 19, 2003)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_191 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 191" ;
    frontlet:hasNarrative "Catches fire started from a kwassa kwassa Domains, Anjouan and Mayotte to direct, 4 dead (Jun 6, 2003)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_200 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 200" ;
    frontlet:hasNarrative "Rif Raf and direct game to Lampedusa, an overloaded boat sank off. 2 dead, 2 missing (Aug 31, 2003)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_237 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 237" ;
    frontlet:hasNarrative "Landing in Fuerteventura. At 20 meters from the shore passengers jumping into the water to touch believing. 4 of them die drowned not knowing to swim (Aug 21, 2004)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_257 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 257" ;
    frontlet:hasNarrative "Tips at the time of the rescue boat off the coast of Fuerteventura, in the Canary Islands, 4 drowned, their bodies lost at sea (Dec 3, 2004)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_288 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 288" ;
    frontlet:hasNarrative "It sinks off Ayvacik, near Canakkale, a boat heading to Greece, 4 missing (May 30, 2005)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_293 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 293" ;
    frontlet:hasNarrative "4 drowned trying to cross the Danube into Austria from Slovakia (Jun 16, 2005)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_308 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 308" ;
    frontlet:hasNarrative "Hidden in the back of a truck, muoino 4 people in a car accident. They were attempting to enter Greece illegally (Sep 10, 2005)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_31 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 31" ;
    frontlet:hasNarrative "Landings in Algeciras, 4 drowned (Jul 24, 2000)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_313 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 313" ;
    frontlet:hasNarrative "Sinking a boat heading to Greece in the Gulf of Saros, 4 dead (Sep 15, 2005)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_324 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 324" ;
    frontlet:hasNarrative "Tamanghasset blocked and threatened by police raids in Algeria, 2 Guineans give up to Europe and take the way back on a truck bound for Kidal, Mali. But during the journey in the desert, the two they die of starvation. The bodies are buried by their fellow passengers in the sand (Oct 18, 2005)" ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:migrant_CollectiveEvent_348 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 348" ;
    frontlet:hasNarrative "Recovered from the waters of the coast of Ragusa, the bodies of four men drowned (Jun 3, 2006)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_37 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 37" ;
    frontlet:hasNarrative "Bari thrown overboard by smugglers during the landing. 2 dead, 2 missing (Aug 9, 2000)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_38 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 38" ;
    frontlet:hasNarrative "Shipwreck off the coast of Almeria, 4 dead bodies recovered (Aug 12, 2000)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_405 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 405" ;
    frontlet:hasNarrative "Rescued a boat off the coast of Tenerife, in the Canary Islands. On board the bodies of three men who died after a week of sailing. Another man died during the journey, the body was thrown into the sea (Mar 8, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_412 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 412" ;
    frontlet:hasNarrative "Lompoul rescued in a canoe adrift. On board 3 deaths and only 2 survivors. Unspecified number of missing, probably tens (May 22, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_422 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 422" ;
    frontlet:hasNarrative "Fished out the bodies of drowned 4, 55 miles south of the island, perhaps victims of the sinking of the first day (Jun 21, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_431 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 431" ;
    frontlet:hasNarrative "Boat rescued off the coast of Arzew, on routes to Spain, 4 missing at sea (Jul 3, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_435 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 435" ;
    frontlet:hasNarrative "Tips vessel 40 miles south of Lampedusa. Sphinx recovered from the ship of the Navy, the bodies of 4 drowned, including that of a child (Jul 18, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_460 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 460" ;
    frontlet:hasNarrative "Boat capsizes 15 miles off the island of Currents, in Pachino (Syracuse), 1 dead and 3 missing (Sep 1, 2007)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_501 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 501" ;
    frontlet:hasNarrative "Rescued by a fishing boat, the remains of migrants drowned 4, 270 km south of Dakhla, off Cap Barbars (Jan 4, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_524 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 524" ;
    frontlet:hasNarrative "Fished in the sea off the coast of Dakhla the bodies of three men and a woman drowned on the routes to the Canary Islands. I could be missing tens (Mar 27, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_533 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 533" ;
    frontlet:hasNarrative "During expulsion in Iraq, the Turkish police throws 18 men in a river along the border to Habur, in the province of Sirnak. 4 die in drowning (Apr 28, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_55 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 55" ;
    frontlet:hasNarrative "Found the bodies of four men drowned in the waters of Ceuta and Castillejos, probably victims of a shipwreck that you do not know anything. Since January 2000, according to official sources, the bodies recovered in the waters of Ceuta are 17 (Dec 9, 2000)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_572 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 572" ;
    frontlet:hasNarrative "Rescued boat adrift off the coast of La Gomera, in the Canary Islands. On board found the bodies of four people (Jul 11, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_602 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 602" ;
    frontlet:hasNarrative "Truckload of immigrants jumping on a mine, 40 km north of Madama, on the border with Libya. The explosion ago 4 deaths (Sep 19, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_607 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 607" ;
    frontlet:hasNarrative "4 migrants killed by landmines in a minefield along the border with Turkey, Kastanjes, in the region of Evros (Sep 26, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_628 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 628" ;
    frontlet:hasNarrative "Rescued two ships with 650 migrants on board, in a stormy sea off Lampedusa. Passengers speak of 4 missing at sea (Nov 28, 2008)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_634 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 634" ;
    frontlet:hasNarrative "Spills at sea off the coast of Dakar, a dugout full of migrants. 4 drown women (Jan 10, 2009)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_673 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 673" ;
    frontlet:hasNarrative "Four migrants killed in the shooting of Egyptian police along the border with Israel in Sinai. Already the 12 people killed since May 2009 (Sep 9, 2009)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_747 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 747" ;
    frontlet:hasNarrative "Arson at the refugee camp of Ras Jdayr, at the border between Tunisia and Libya, where there are thousands of displaced people who fled the war in Libya. Deaths 4 Eritreans (May 23, 2011)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_751 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 751" ;
    frontlet:hasNarrative "The Egyptian border police opened fire on a group of Sudanese intent to pass the Israeli border in the Sinai Desert, killing 4 men (Jun 25, 2011)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_764 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 764" ;
    frontlet:hasNarrative "The lifeless bodies of four men have surfaced from the sea along the coast of Izmir, Seferihisar, on the route to the Greek island of Samos. The number of missing unknown shipwreck (Sep 21, 2011)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_779 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 779" ;
    frontlet:hasNarrative "Found the bodies of four people drowned in Nador and Melilla trying to swim across the border with the Spanish enclave of Melilla, Morocco (Jan 20, 2012)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_8 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 8" ;
    frontlet:hasNarrative "It overturns a boat load of immigrants into the Danube River, on the border between Slovakia and Austria, 4 dead (Mar 11, 2000)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_801 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 801" ;
    frontlet:hasNarrative "Shipwreck in the Straits of Gibraltar, off the coast of Tarifa, a small boat carrying six passengers. 2 dead, 2 missing in sea (Mar 2, 2013)" ;
    frontlet:totalDeadAndMissing 4 .

frontlet_data:migrant_CollectiveEvent_85 a frontlet:CollectiveEvent ;
