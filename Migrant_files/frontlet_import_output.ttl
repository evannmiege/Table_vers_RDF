frontlet_data:migrant_CollectiveEvent_113 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 113" ;
    frontlet:hasNarrative "Boat rescued off Cesvos, 2 dead, 4 missing (Dec 3, 2001)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_130 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 130" ;
    frontlet:hasNarrative "Otranto: 6 bodies recovered related to the hull of a boat in distress. The boat, which had departed from Vlora, was set on fire. 23 Survivors (Mar 11, 2002)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_174 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 174" ;
    frontlet:hasNarrative "Recovered from the sea the remains of six people on the island of Symi (Jan 7, 2003)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_22 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 22" ;
    frontlet:hasNarrative "Inflatable Party from Morocco crashing against the rocks in Tarifa, 6 dead (May 13, 2000)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_316 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 316" ;
    frontlet:hasNarrative "Vessel in distress rescued off Lampedusa, 6 missing (Sep 24, 2005)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_318 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 318" ;
    frontlet:hasNarrative "Intercepted by the Guardia Civil boat a lot from Nador to Ceuta. A witness complaint: 3 dead passengers thrown into the sea by the military (Oct 1, 2005)" ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:migrant_CollectiveEvent_32 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 32" ;
    frontlet:hasNarrative "Party from Domoni (Anjouan) a kwassa-kwassa is shipwrecked off the coast of Mayotte, 6 dead (Aug 4, 2000)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_358 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 358" ;
    frontlet:hasNarrative "They go out of your way to get away to a police station because no papers to enter Germany. In the incident, near Koenigs Wusterhausen (Brandenburg) die 6 of 8 passengers (Aug 2, 2006)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_458 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 458" ;
    frontlet:hasNarrative "Landing in Lampedusa Cala Pisa. Passengers speak of 6 died of starvation in eight days adrift (Aug 25, 2007)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_467 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 467" ;
    frontlet:hasNarrative "Boat capsizes a mile from Cabo de Gata, Andalusia. Recovered a dead body in Nijar, Almeria, 5 missing (Sep 18, 2007)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_503 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 503" ;
    frontlet:hasNarrative "Discovered in Los Canos, Barbate, the bodies of six migrants drowned (Jan 6, 2008)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_512 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 512" ;
    frontlet:hasNarrative "Shipwreck off Vintage, on routes to Sardinia, at least 6 missing (Feb 1, 2008)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_523 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 523" ;
    frontlet:hasNarrative "6 recovered corpses, including that of a Somali woman, Ayse Abdurrahman, off Tekagac, near Didim, in the province of Aydin, victims of a shipwreck that could have made more victims (Mar 23, 2008)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_589 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 589" ;
    frontlet:hasNarrative "Intercepted off the coast of Dakhla boat with 51 migrants on board. Among them, the bodies of six men died of starvation during the journey (Aug 28, 2008)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_626 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 626" ;
    frontlet:hasNarrative "Found the remains of 6 migrants in the Algerian desert to the border with Mali, in Tanezrouft, including Regane and Bordj Badji Mokhtar. In September, more victims were found in the same region (Nov 20, 2008)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_676 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 676" ;
    frontlet:hasNarrative "Landing at Gela. 3 bodies recovered. Three others remain missing (Oct 7, 2009)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_701 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 701" ;
    frontlet:hasNarrative "Shooting on the border between Egypt and Israel at Sinai. 6 Eritreans were killed, two under-fire police, 4 shots under their carers (Aug 14, 2010)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_714 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 714" ;
    frontlet:hasNarrative "A group of 250 Eritreans, 80 of which are rejected by Italy in Libya last year, ends sequestered into the hands of smugglers who have entrusted themselves to cross the border between Egypt and Israel in the Sinai. The redemption price is set at $ 8,000. An escape attempt fails and is repressed with unprecedented violence, resulting in the killing of six Eritreans (Nov 30, 2010)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_721 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 721" ;
    frontlet:hasNarrative "Found in Bouharoun, Tipaza, the lifeless bodies of 6 boys drowned during the crossing to Spain (Feb 15, 2011)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_767 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 767" ;
    frontlet:hasNarrative "3 found dead off the coast of Calblanque and 2 off Calarreona and Punta Negrete, in the area of __Murcia, they are the 5 missing in a boat rescued a few days before (Oct 13, 2011)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_81 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 81" ;
    frontlet:hasNarrative "A boat hits a rocky islet of Chtapodia, in the Cyclades, and sinks, 6 drowned (Jun 15, 2001)" ;
    frontlet:totalDeadAndMissing 6 .

frontlet_data:migrant_CollectiveEvent_820 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 820" ;
    frontlet:hasNarrative "A boat runs aground just 15 meters from the shore, in Catania. At the landing, passengers drown 6 (Aug 11, 2013)" ;
    frontlet:totalDeadAndMissing 6 .

