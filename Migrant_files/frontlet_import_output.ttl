frontlet_data:migrant_testimonyEvent_434_1 a frontlet:IndividualEvent,
        frontlet:Testimony ;
    frontlet:group frontlet_data:migrant_CollectiveEvent_434 ;
    frontlet:hasComment "Detected event type: Testimony",
        "Landed in Lampedusa, a witness said he counted 34 dead bodies in the desert between Madama and the Libyan border to Toumou, a month earlier. Deaths dehydrated, it is unclear whether the journey to Libya as if following the expulsion from Libya. No trace of the car they were traveling on board the (Jul 16, 2007) | lampedusa | Niger | Fortress Europe | http://fortresseurope.blogspot.com/2006/01/luglio-2006.html" ;
    temp:before frontlet_data:migrant_Death_434_1 .

