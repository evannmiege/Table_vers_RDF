frontlet:Country a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    skos:definition "Pays de naissance d'un migrant ou pays traversé lors d'une migration"@fr ;
    skos:prefLabel "Country"@en,
        "Pays"@fr .

frontlet:Age a owl:Class ;
    rdfs:subClassOf frontlet:AgeEntity ;
    skos:definition "Valeur précise de l'âge d'un migrant. Il peut être négatif pour une perte prénatale ou à virgule dans le cas d'un enfant de moins d'un an",
        "Precise value of a migrant age. It can be negative for a prenatal loss or real in case of a less than one year old child"@en ;
    skos:prefLabel "Age"@en,
        "Age"@fr .

frontlet:Death a owl:Class ;
    rdfs:subClassOf frontlet:DeathInjury ;
    skos:definition "Event consisting in the death of a migrant crossing a border"@en,
        "Evènement consistant à la mort d'un migrant dans le cadre du franchissement d'une frontière."@fr ;
    skos:prefLabel "Death"@en,
        "Mort"@fr .

frontlet:Person a owl:Class ;
    skos:definition "A person undertakes a journey between two countries"@en,
        "Un personne entreprend un trajet entre deux pays"@fr ;
    skos:prefLabel "Person"@en,
        "Personne"@fr .

frontlet:IndividualEvent a owl:Class ;
    rdfs:subClassOf frontlet:Event,
        geo:Feature ;
    skos:definition "Individual event in the journey of a migrant"@en,
        "Evènement dans la trajectoire de migration d'un migrant"@fr ;
    skos:prefLabel "Individual Event"@en,
        "Evènement individuel"@fr .

