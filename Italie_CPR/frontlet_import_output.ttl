frontlet:AgeInterval a owl:Class ;
    rdfs:subClassOf frontlet:AgeEntity ;
    skos:definition "Age interval where the migrant age is"@en,
        "Intervalle d'âge dans lequel un migrant se trouve"@fr ;
    skos:prefLabel "Age interval"@en,
        "Inervalle d'âge"@fr .

frontlet_data:italie_Country_EGY a frontlet:Country ;
    rdfs:label "Egypt"@en ;
    frontlet:isoAlpha2 "EG" ;
    frontlet:isoAlpha3 "EGY" ;
    skos:notation "EGY" .

frontlet_data:italie_Country_GIN a frontlet:Country ;
    rdfs:label "Guinea"@en ;
    frontlet:isoAlpha2 "GN" ;
    frontlet:isoAlpha3 "GIN" ;
    skos:notation "GIN" .

frontlet_data:italie_Country_PAK a frontlet:Country ;
    rdfs:label "Pakistan"@en ;
    frontlet:isoAlpha2 "PK" ;
    frontlet:isoAlpha3 "PAK" ;
    skos:notation "PAK" .

frontlet_data:italie_cpr_DeathCause_accident a frontlet:DeathCause ;
    rdfs:label "accident" .

frontlet:AgeEntity a owl:Class ;
    skos:definition "Super class dealing with migrant age"@en,
        "Super classe gérant l'âge d'un migrant"@fr ;
    skos:prefLabel "Age entity"@en,
        "Entité âge"@fr .

frontlet:DeathInjury a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Event consisting in the death or the injury of a migrant crossing a border"@en,
        "Evènement consistant à la blessure ou la mort d'un migrant lors du passage d'une frontière."@fr ;
    skos:prefLabel "Death injury"@en,
        "Mort blessure"@fr .

frontlet:Event a owl:Class ;
    skos:definition "A life moment of a migrant during its journey"@en,
        "Un moment de la vie d'un migrant durant son trajet."@fr ;
    skos:prefLabel "Event"@en,
        "Evènement"@fr .

frontlet:OfficialDocument a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "Official document attesting the passage or the death of a migrant"@en,
        "Document officiel attestant du passage ou de la mort d'un migrant"@fr ;
    skos:prefLabel "Official document"@en,
        "Document officiel"@fr .

frontlet_data:italie_Country_BGD a frontlet:Country ;
    rdfs:label "Bangladesh"@en ;
    frontlet:isoAlpha2 "BD" ;
    frontlet:isoAlpha3 "BGD" ;
    skos:notation "BGD" .

frontlet_data:italie_cpr_DeathCause_inconnu a frontlet:DeathCause ;
    rdfs:label "inconnu" .

frontlet_data:italie_cpr_DeathNature_inconnu a frontlet:DeathNature ;
    rdfs:label "inconnu" .

frontlet_data:italie_Country_NGA a frontlet:Country ;
    rdfs:label "Nigeria"@en ;
    frontlet:isoAlpha2 "NG" ;
    frontlet:isoAlpha3 "NGA" ;
    skos:notation "NGA" .

frontlet:DeathNature a owl:Class ;
    skos:definition "Nature de la mort d'un migrant"@fr .

time:Thursday a time:DayOfWeek ;
    rdfs:label "Thursday"@en .

frontlet_data:italie_cpr_DeathCause_me_dical a frontlet:DeathCause ;
    rdfs:label "médical" ;
    skos:closeMatch thes:medicalIssue .

frontlet_data:italie_cpr_DeathNature_me_dical a frontlet:DeathNature ;
    rdfs:label "médical" .

frontlet:Media a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "The information source comes from a media"@en,
        "La source d'information vient d'un média"@fr ;
    skos:prefLabel "Media"@en,
        "Media"@fr .

time:Tuesday a time:DayOfWeek ;
    rdfs:label "Tuesday"@en .

frontlet_data:italie_Country_MAR a frontlet:Country ;
    rdfs:label "Morocco"@en ;
    frontlet:isoAlpha2 "MA" ;
    frontlet:isoAlpha3 "MAR" ;
    skos:notation "MAR" .

frontlet_data:italie_cpr_DeathCause_incendie a frontlet:DeathCause ;
    rdfs:label "incendie" ;
    skos:closeMatch thes:fire .

frontlet_data:italie_cpr_DeathCountry_ITA a frontlet:Country,
        frontlet:DeathCountry ;
    rdfs:label "Italy"@en .

frontlet:DeathCause a owl:Class ;
    skos:definition "Manière précise dont un migrant est décédé"@fr .

time:Friday a time:DayOfWeek ;
    rdfs:label "Friday"@en .

time:Monday a time:DayOfWeek ;
    rdfs:label "Monday"@en .

time:Sunday a time:DayOfWeek ;
    rdfs:label "Sunday"@en .

frontlet_data:italie_cpr_DeathNature_accident a frontlet:DeathNature ;
    rdfs:label "accident" .

time:Saturday a time:DayOfWeek ;
    rdfs:label "Saturday"@en .

time:Wednesday a time:DayOfWeek ;
    rdfs:label "Wednesday"@en .

frontlet_data:italie_cpr_DeathCause_pendaison a frontlet:DeathCause ;
    rdfs:label "pendaison" ;
    skos:closeMatch thes:hanging .

frontlet_data:italie_cpr_DeathNature_suicide a frontlet:DeathNature ;
    rdfs:label "suicide" .

frontlet_data:italie_Country_TUN a frontlet:Country ;
    rdfs:label "Tunisia"@en ;
    frontlet:isoAlpha2 "TN" ;
    frontlet:isoAlpha3 "TUN" ;
    skos:notation "TUN" .

frontlet:Country a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    skos:definition "Pays de naissance d'un migrant ou pays traversé lors d'une migration"@fr ;
    skos:prefLabel "Country"@en,
        "Pays"@fr .

frontlet:Age a owl:Class ;
    rdfs:subClassOf frontlet:AgeEntity ;
    skos:definition "Valeur précise de l'âge d'un migrant. Il peut être négatif pour une perte prénatale ou à virgule dans le cas d'un enfant de moins d'un an",
        "Precise value of a migrant age. It can be negative for a prenatal loss or real in case of a less than one year old child"@en ;
    skos:prefLabel "Age"@en,
        "Age"@fr .

frontlet:CivilSociety a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "The information source comes from a civil society orgnism (NGO)"@en,
        "La source d'information vient d'un organisme type sociétée civile (ONG)"@fr ;
    skos:prefLabel "Civil society"@en,
        "Sociétée civile"@fr .

frontlet:Death a owl:Class ;
    rdfs:subClassOf frontlet:DeathInjury ;
    skos:definition "Event consisting in the death of a migrant crossing a border"@en,
        "Evènement consistant à la mort d'un migrant dans le cadre du franchissement d'une frontière."@fr ;
    skos:prefLabel "Death"@en,
        "Mort"@fr .

frontlet:Person a owl:Class ;
    skos:definition "A person undertakes a journey between two countries"@en,
        "Un personne entreprend un trajet entre deux pays"@fr ;
    skos:prefLabel "Person"@en,
        "Personne"@fr .

frontlet:Source a owl:Class ;
    skos:definition "Information source of an event"@en,
        "Source de l'information d'un évènement"@fr ;
    skos:prefLabel "Source"@en,
        "Source"@fr .

frontlet:IndividualEvent a owl:Class ;
    rdfs:subClassOf frontlet:Event,
        geo:Feature ;
    skos:definition "Individual event in the journey of a migrant"@en,
        "Evènement dans la trajectoire de migration d'un migrant"@fr ;
    skos:prefLabel "Individual Event"@en,
        "Evènement individuel"@fr .

