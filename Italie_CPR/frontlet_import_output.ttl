frontlet:AgeCategory a owl:Class ;
    rdfs:subClassOf frontlet:AgeInterval ;
    skos:definition "General age categories found in migrations tales when the authors do not have the exact age of the migrant. These categories are predefined intervals."@en,
        "Catégories d'âge génériques que l'on retrouve dans les récits de migrations lorsque l'on a pas l'information sur l'âge réel d'un migrant. Ces catégories représentent des intervalles prédéfinis."@fr .

frontlet:Call a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Ante mortem event consisting in a migrant calling a close person"@en,
        "Evènement ante mortem consistant à un migrant ayant passé un appel téléphonique avec un proche"@fr ;
    skos:prefLabel "Call"@en,
        "Appel"@fr .

frontlet:CivilSociety a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "The information source comes from a civil society orgnism (NGO)"@en,
        "La source d'information vient d'un organisme type sociétée civile (ONG)"@fr ;
    skos:prefLabel "Civil society"@en,
        "Sociétée civile"@fr .

frontlet:CollectiveEvent a owl:Class ;
    rdfs:subClassOf frontlet:Event,
        geo:Feature ;
    skos:definition "An event potentially shared by mulitple migrants. Events can be slighlty different (a death and an injury)"@en,
        "Un évènement partagé par au moins deux migrants. Les évènements peuvent être légèrement différents (un décès et une blessure)."@fr ;
    skos:prefLabel "Collective event"@en,
        "Evènement collectif"@fr .

frontlet:Control a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Ante mortem event consisting in a police control or an NGO grouping migrant names with a date and a place"@en,
        "Evènement ante mortem consistant à un contrôle de police ou d'une ONG regroupant le nom d'un migrant ainsi qu'un lieu et une date"@fr ;
    skos:prefLabel "Control"@en,
        "Contrôle"@fr .

frontlet:Conversation a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Ante mortem event where a migrant discussed with another person in a physical way"@en,
        "Evènement ante mortem où un migrant a discuté avec une autre personne de manière physique"@fr ;
    skos:prefLabel "Conversation"@en,
        "Conversation"@fr .

frontlet:CorpseAnalysis a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Post mortem event consisting in analyzing the corpse if a deceased migrant"@en,
        "Evènement post mortem consistant à analyser le corps d'un migrant décédé"@fr ;
    skos:prefLabel "Corpse analysis"@en,
        "Analyse du corps"@fr .

frontlet:CorpseRepatriation a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Post mortem event consisting in rapatriating a dead migran corpse"@en,
        "Evènement post mortem consistant au rapatriement du corps d'un migrant décédé dans son pays d'origine."@fr ;
    skos:prefLabel "Corpse repatriation"@en,
        "Rapatriement du corps"@fr .

frontlet:DeathCertificate a owl:Class ;
    rdfs:subClassOf frontlet:OfficialDocument ;
    skos:definition "Death certificate of a migrant"@en,
        "Certificat de décès d'un migrant"@fr ;
    skos:prefLabel "Death certificate"@en,
        "Certificat de décès"@fr .

frontlet:Family a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "The source information comes from a family member or a migrant close person"@en,
        "La source d'une information vient d'un membre de la famille ou d'un proche d'un migrant"@fr ;
    skos:prefLabel "Family"@en,
        "Famille"@fr .

frontlet:Gender a owl:Class ;
    skos:definition "Genre d'une personne"@fr .

frontlet:Inhumation a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Post mortem event consisting in the inhumation ceremony of a deceased migrant corpse"@en,
        "Evènement post mortem consistant à la cérémonie d'inhumation du corps d'un migrant décédé."@fr ;
    skos:prefLabel "Inhumation"@en,
        "Inhumation"@fr .

frontlet:Injury a owl:Class ;
    rdfs:subClassOf frontlet:DeathInjury ;
    skos:definition "Event consisting in the injury of a migrant crossing a border"@en,
        "Evènement ante mortem où un migrant est blessé lors d'une tentative de franchissement d'une frontière."@fr ;
    skos:prefLabel "Injury"@en,
        "Blessure"@fr .

frontlet:Media a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "The information source comes from a media"@en,
        "La source d'information vient d'un média"@fr ;
    skos:prefLabel "Media"@en,
        "Media"@fr .

frontlet:MediaType a owl:Class ;
    skos:definition "Type de média servant de source au décès d'un migrant"@fr .

frontlet:OtherOfficialDocument a owl:Class ;
    rdfs:subClassOf frontlet:OfficialDocument ;
    skos:definition "Other official document attesting the passage or the death of a migrant"@en,
        "Autre document officiel attestant du passage ou de la mort d'un migrant"@fr ;
    skos:prefLabel "Other offical document"@en,
        "Autre document officiel"@fr .

frontlet:Testimony a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Ante mortem event consisting in one person seing a migrant without getting directly in contact with him."@en,
        "Evènement ante mortem consistant en une personne ayant vu un migrant sans être directement entré en contact avec celui-ci."@fr ;
    skos:prefLabel "Testimony"@en,
        "Témoignage"@fr .

frontlet:Trace a owl:Class ;
    rdfs:subClassOf frontlet:IndividualEvent ;
    skos:definition "Ante mortem event consisting in a abandonned object owned by a migrant at a given moment of his journey"@en,
        "Evènement ante mortem consistant dans un objet laissé par un migrant à un moment donné de son voyage"@fr ;
    skos:prefLabel "Trace"@en,
        "Trace"@fr .

frontlet:Transport a owl:Class ;
    skos:definition "Trasport mean used by a migrant during an event"@en,
        "Moyen de transport utilisé par un migrant au moment d'un évènement"@fr ;
    skos:prefLabel "Transport"@en,
        "Transport"@fr .

