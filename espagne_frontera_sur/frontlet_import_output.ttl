frontlet:AgeInterval a owl:Class ;
    rdfs:subClassOf frontlet:AgeEntity ;
    skos:definition "Age interval where the migrant age is"@en,
        "Intervalle d'âge dans lequel un migrant se trouve"@fr ;
    skos:prefLabel "Age interval"@en,
        "Inervalle d'âge"@fr .

frontlet_data:espagne_CollectiveEvent_11 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "AMDH Nador reporta el entierro de 2 personas que murieron en la frontera de Marruecos con Argelia." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_119 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Aparecen los cuerpos de 2 personas de origen subsahariano en las costas de Donabbou (Tánger)." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_120 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "2 jóvenes argelinos desaparecen en las costas de Orán. Ghafour Ilyes 17 años y Zahaf Houwari 17 años" ;
    frontlet:numberDead 0 ;
    frontlet:numberMissing 2 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_133 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Aparecen dos cadáveres de dos hombres marroquíes en Fuengirola - Málaga." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_135 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Fallece un hombre durante la travesía y otra desaparece de una patera en la que viajaba junto a 13 personas más. Fueron rescatados por SM y trasladados a Mallorca." ;
    frontlet:numberDead 1 ;
    frontlet:numberMissing 1 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_148 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Mueren dos hombres de origen subsahariano durante la travesía de una embarcación que llegó a Mauritania." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_164 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Autoridades marroquíes encuentran 2 cadáveres en la interceptación de una embarcación en la que viajaban 274 personas de origen subsahariano." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_178 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Desaparecen Ilyas e Ismail, dos chicos marroquíes desaparecidos en El Estrecho. Salieron 3 y solo uno fue localizado." ;
    frontlet:numberDead 0 ;
    frontlet:numberMissing 2 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_18 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Naufraga una patera con 15 personas en las costas de Almería. 13 supervivientes y 2 cuerpos encontrados." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_2 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Aparecen el cuerpo de un hombre y una mujer en diferentes zonas de Fuerteventura." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_200 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "AMDH Nador reporta la aparición de dos cuerpos en Bounidar y en Beni Enzar en avanzado estado de descomposición." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_203 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Aparecen 2 cuerpos en la playa de Camposoto - cerca de donde aparecieron los 3 cuerpos del 29 de noviembre - en avanzado estado de descomposición" ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_207 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Mueren un niño y un adolescente de frio en el cayuco que fue rescatado y trasladado a Gran Canaria. Procedentes de Mali." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_44 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "2 personas fueron arrojadas por la borda durante la travesía. SM rescató a las otras 18 personas y traslado a Almería." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_48 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "AMDH reporta la desaparición de 2 jóvenes, Lhadi boutahar y Mohamed Zaalouki., cuando intentaron acceder a Melilla a nado." ;
    frontlet:numberDead 0 ;
    frontlet:numberMissing 2 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_5 a frontlet:CollectiveEvent ;
