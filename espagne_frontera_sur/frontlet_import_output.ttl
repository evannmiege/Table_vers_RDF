frontlet:AgeEntity a owl:Class ;
    skos:definition "Super class dealing with migrant age"@en,
        "Super classe gérant l'âge d'un migrant"@fr ;
    skos:prefLabel "Age entity"@en,
        "Entité âge"@fr .

frontlet:Event a owl:Class ;
    skos:definition "A life moment of a migrant during its journey"@en,
        "Un moment de la vie d'un migrant durant son trajet."@fr ;
    skos:prefLabel "Event"@en,
        "Evènement"@fr .

frontlet:OfficialDocument a owl:Class ;
    rdfs:subClassOf frontlet:Source ;
    skos:definition "Official document attesting the passage or the death of a migrant"@en,
        "Document officiel attestant du passage ou de la mort d'un migrant"@fr ;
    skos:prefLabel "Official document"@en,
        "Document officiel"@fr .

frontlet_data:espagne_CollectiveEvent_121 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Las personas rescatadas de esta patera relatan que viajaban 17 personas y que 2 personas han fallecido y 1 ha desaparecido cuando salieron de las costas de Tipazza en Argelia." ;
    frontlet:numberDead 1 ;
    frontlet:numberMissing 2 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_138 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Las familias de Rafiq Al-Gramawi y Abdul Salam Al-Samour identifican los cuerpos de sus hijos en el hospital de Nador, encontrados en la zona de Beni Enzar. El otro cuerpo pertenece a Rafiq Al-Gharamawi." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_162 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "La Marina Marroquí recupera 3 cuerpos procedentes de Senegal de una embarcación que naufragó cerca de Dajla." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_168 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Mueren 3 hombres procedentes de Gambia en El Hierro; uno en el centro de acogida, el segundo mientras era trasladado en helicóptero al hospital y el tercero falleció durante la travesía y fue encontrado en la embarcación." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_171 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "3 personas fallecen durante la travesía de un cayuco procedente de Gambia en el que viajaban 209 personas." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_196 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Fallecen 4 personas tras ser arrojados de una patera en Sancti Petri y Camposoto. Aparecen 3 cuerpos en Camposoto - San Fernando." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_198 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Fallecen 3 personas durante la travesía de una patera que salió de Dajla. Entre las personas fallecidas hay un hombre, una mujer y una menor de 14 años." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_41 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "AMDH reporta la muerte de 3 hombres de origen subsahariano durante el intento de acceso a Melilla a través del vallado fronterizo." ;
    frontlet:numberDead 3 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_73 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Encuentran el cuerpo de uno de los chicos desaparecidos. Abdenour Rifi, de 25 años, Oussama Chepot de 24 y Achraf Driouich de 21 habían salido el fin de semana del 10 y 11 de junio desde Marruecos." ;
    frontlet:numberDead 1 ;
    frontlet:numberMissing 2 ;
    frontlet:totalDeadAndMissing 3 .

frontlet_data:espagne_CollectiveEvent_82 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Familiares buscan a Ayoub y Hamza, 16 y 20 años, en Ceuta. Otro compañero ha aparecido muerto en aguas de Marruecos." ;
    frontlet:numberDead 1 ;
