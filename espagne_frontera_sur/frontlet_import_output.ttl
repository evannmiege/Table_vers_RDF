    frontlet:hasNarrative "Fallen 2 hombres durante la travesía de esta patera por disparos de la gendarmería marroquí." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_66 a frontlet:CollectiveEvent ;
    frontlet:hasNarrative "Naufraga una patera en las costas de Argelia con 22 personas de origen sirio. 2 pierden la vida y fueron rescatados por Protección Civil Marítima en Tipazza. Los cuerpos fueron trasladados al puerto de Cherchell." ;
    frontlet:numberDead 2 ;
    frontlet:numberMissing 0 ;
    frontlet:totalDeadAndMissing 2 .

frontlet_data:espagne_CollectiveEvent_68 a frontlet:CollectiveEvent ;
