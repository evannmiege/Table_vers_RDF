        frontlet:IndividualEvent .

frontlet_data:pologne_Death_10 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause """uton?? w Bugu; Cia?o 19-latka nurkowie wydobyli 20 pa?dziernika. Sekcja zw?ok wykaza?a, ?e przyczyn? ?mierci by?o utoni?cie. M??czyzna pochodzi? ze zrujnowanego miasta Homs w Syrii. Przebywa? w obozie dla uchod?ców w Jordanii, gdzie Syryjczycy schronili si? przed wojn? domow?. W obozie zacz?? studia. Wedle relacji wspó?towarzysza ch?opaka, do rzeki mia? go wepchn?? bia?oruski stra?nik graniczny, cho? Syryjczyk krzycza?, ?e nie umie p?ywa?. 
Pochowany na mizarze w Bohonikach; By? to pierwszy pogrzeb cudzoziemca, który zmar? na terenie Polski po przekroczeniu granicy z Bia?orusi?. Cia?o do Bohonik sprowadzi?a bia?ostocka Fundacja Dialog. Rodzina Syryjczyka uczestniczy?a w pogrzebie przez po??czenie online.""" ;
    frontlet:hasDeathCountry frontlet_data:pologne_DeathCountry_POL ;
    frontlet:hasNarrative "Uton?? w Bugu. Cia?o 19-latka nurkowie wydobyli 20 pa?dziernika. Sekcja zw?ok wykaza?a, ?e przyczyn? ?mierci by?o utoni?cie. M??czyzna pochodzi? ze zrujnowanego miasta Homs w Syrii. Przebywa? w obozie dla uchod?ców w Jordanii, gdzie Syryjczycy schronili si? przed wojn? domow?. W obozie zacz?? studia." ;
    frontlet:lieu "Bug" ;
    frontlet:sourcedBy frontlet_data:pologne_Source_10 ;
    geo:hasGeometry frontlet_data:pologne_geometry_10 ;
    time:dayOfWeek time:Tuesday ;
    time:inXSDDate "2021-10-19"^^xsd:date .

frontlet_data:pologne_Death_11 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause thes:deathCause ;
    frontlet:hasNarrative "Przy ciele nie znaleziono dokumentów - nie uda?o si? ustali? to?samo?ci m??czyzny. Prawdopodobnie pochodzi? ze Sri Lanki." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_11 ;
    time:dayOfWeek time:Friday ;
    time:inXSDDate "2021-10-22"^^xsd:date .

frontlet_data:pologne_Death_12 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "cukrzyca, informacja z Bia?orusi" ;
    frontlet:hasNarrative "Zmar? po stronie bia?oruskiej w obozowisku. Prawdopodobnie chorowa? na cukrzyc?." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_12 ;
    time:dayOfWeek time:Wednesday ;
    time:inXSDDate "2021-10-27"^^xsd:date .

frontlet_data:pologne_Death_13 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasNarrative "Zmar? po stronie bia?oruskiej w obozowisku. Autor nagrania, na którym wida? dwa cia?a przykryte foli? NRC, mówi?, ?e w obozowisku przebywa?o w tamtym czasie 300 osób, cz??? w bardzo z?ym stanie." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_13 ;
    time:dayOfWeek time:Wednesday ;
    time:inXSDDate "2021-10-27"^^xsd:date .

frontlet_data:pologne_Death_14 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "Cukrzyca i schorzenia kr?gos?upa, po?redni? przyczyn? ?mierci by? brak dost?pu do leków. S?u?by rozdzieli?y jego i rodzin?, zosta? sam." ;
    frontlet:hasNarrative "Kurd z Iraku. Chorowa? na cukrzyc?, mia? te? problemy z kr?gos?upem. Po?redni? przyczyn? ?mierci by? brak dost?pu do leków." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_14 ;
    time:dayOfWeek time:Wednesday ;
    time:inXSDDate "2021-10-27"^^xsd:date .

frontlet_data:pologne_Death_15 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "udar mózgu" ;
    frontlet:hasNarrative "Kurd z Iraku. Zmar? w Mi?sku po powrocie spod granicy, na skutek udaru mózgu." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_15 ;
    time:dayOfWeek time:Sunday ;
    time:inXSDDate "2021-10-31"^^xsd:date .

frontlet_data:pologne_Death_16 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "zmar?a po wywózce do Bia?orusi; \"Z kolei 43-letnia Syryjko-Palestynka Rajaa Hasan Hasan najprawdopodobniej zmar?a z wych?odzenia. Próbowa?a wróci? do Syrii, ale bia?oruskie s?u?by mia?y j? zawróci?  i przerzuca? do kolejnych koczowisk przy granicy.\"" ;
    frontlet:hasNarrative "Syryjko-Palestynka, zmar?a najprawdopodobniej z wych?odzenia. Próbowa?a wróci? do Syrii, ale bia?oruskie s?u?by zawróci?y j? i przerzuca?y mi?dzy kolejnymi obozowiskami przy granicy." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_16 ;
    time:dayOfWeek time:Monday ;
    time:inXSDDate "2021-11-08"^^xsd:date .

frontlet_data:pologne_Death_17 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "m?odszy brat prosi? o pomoc SG, gdy Mohammed jeszcze ?y?, ten zosta? jednak wywieziony - nie udzielono mu pomocy; - Ujawnione zw?oki nale?? najprawdopodobniej do m??czyzny w wieku 21 lat, obywatelstwa syryjskiego. Przy zmar?ym nie znaleziono paszportu, lecz bilet lotniczy, za?wiadczenie o szczepieniu na COVID i dokumenty w j?zyku arabskim. Nie pozwalaj? one na identyfikacj? osoby - przekaza? Onetowi Jan Andrejczuk, prokurator rejonowy w Hajnówce." ;
    frontlet:hasDeathCountry frontlet_data:pologne_DeathCountry_POL ;
    frontlet:hasNarrative "M?ody m??czyzna z Syrii. Jego m?odszy brat prosi? o pomoc SG, gdy Mohammed jeszcze ?y?. Nie udzielono mu pomocy, brata z kolei wywieziono na stron? bia?orusk?." ;
    frontlet:lieu "Czeremcha / Wólka Terechowska" ;
    frontlet:sourcedBy frontlet_data:pologne_Source_17 ;
    geo:hasGeometry frontlet_data:pologne_geometry_17 ;
    time:dayOfWeek time:Thursday ;
    time:inXSDDate "2021-11-11"^^xsd:date .

frontlet_data:pologne_Death_18 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause """Matk? by?a Avin Irfan Zahir, która po przedwczesnym porodzie/poronieniu zmar?a 3.12.2021,
pochowany na mizarze w Bohonikach""" ;
    frontlet:hasDeathCountry frontlet_data:pologne_DeathCountry_POL ;
    frontlet:hasNarrative "Dziecko, którego matk? by?a Avin Irfan Zahir. Avin urodzi?a przedwcze?nie - w 24 tygodniu ci??y. Dziecko by?o oczekiwane, mia?o wybrane imi?. Mia?o urodzi? si? w bezpiecznym kraju." ;
    frontlet:lieu "szpital w Hajnówce" ;
    geo:hasGeometry frontlet_data:pologne_geometry_18 ;
    time:dayOfWeek time:Sunday ;
    time:inXSDDate "2021-11-14"^^xsd:date .

frontlet_data:pologne_Death_19 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "Próbowa? 9 razy dosta? si? do Polski, ostatecznie zmar? w samochodzie na granicy polsko-niemieckiej." ;
    frontlet:hasNarrative "Próbowa? 9 razy dosta? si? do Polski, ostatecznie zmar? w samochodzie na granicy polsko-niemieckiej." ;
    time:dayOfWeek time:Tuesday ;
    time:inXSDDate "2021-11-23"^^xsd:date .

frontlet_data:pologne_Death_2 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause """zw?oki ujawniono 19.09.2021
zmar? z wych?odzenia, cia?o wróci?o do Iraku""" ;
    frontlet:hasDeathCountry frontlet_data:pologne_DeathCountry_POL ;
    frontlet:hasNarrative "Zmar? z wych?odzenia, cia?o wróci?o do Iraku." ;
    frontlet:lieu "Fr?cki pod Gibami" ;
    frontlet:sourcedBy frontlet_data:pologne_Source_2 ;
    geo:hasGeometry frontlet_data:pologne_geometry_2 ;
    time:dayOfWeek time:Saturday ;
    time:inXSDDate "2021-09-18"^^xsd:date .

frontlet_data:pologne_Death_20 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause """hipotermia i kwasica + wycie?czenie;

38-latka do szpitala w Hajnówce trafi?a 12 listopada. Mimo zaawansowanej ci??y ukrywa?a si? przed polsk? stra?? graniczn?, chcia?a unikn?? kolejnego push-backu na stron? bia?orusk?. W lesie pod Narewk? znale?li j? wolontariusze z Grupy Granica. Temperatura jej cia?a wynosi?a 28 stopni, a oprócz hipotermii kobieta mia?a te? kwasic?. Poroni?a dwa dni pó?niej, w 24. tygodniu ci??y. Nie pomog?o dializowanie i nieprzytomna kobieta zmar?a 3 grudnia wieczorem."
pochowana na mizarze w Bohonikach""" ;
    frontlet:hasDeathCountry frontlet_data:pologne_DeathCountry_POL ;
