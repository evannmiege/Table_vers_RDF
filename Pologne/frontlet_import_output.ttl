frontlet_data:pologne_Death_67 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause """Za wyborcz? (na podstawie komunikatu gpk): 
"Jak stwierdzi?y bia?oruskie s?u?y graniczne, obywatel Syrii mia? powiedzie?, ?e zosta? wypchni?ty razem z nim Egipcjanin, który rzekomo przed tym zdarzeniem potrzebowa? pomocy medycznej, by? skrajnie wycie?czony. Bia?orusini utrzymuj?, ?e „ignoruj?c krytyczny stan Egipcjanina, polskie si?y bezpiecze?stwa kontynuowa?y zn?canie si? i bicie m??czyzn, zabieraj?c ich rzeczy i pieni?dze", a „nast?pnie, u?ywaj?c gazu, zmusili cudzoziemców do przej?cia przez szlaban". W komunikacie Pa?stwowego Komitetu Granicznego Republiki Bia?oru? mo?na przeczyta?: „Syryjczykowi uda?o si? przenie?? nieprzytomnego towarzysza kilkadziesi?t metrów, ale m??czyzna zmar?. Wezwano na miejsce karetk? pogotowia, lekarz stwierdzi? zgon uchod?cy. Obywatelowi Syrii udzielono niezb?dnej pomocy\"""" ;
    frontlet:hasNarrative "Egipcjanin zmar? prawdopodobnie na skutek pobicia przez polsk? stra? graniczn?. O ?mierci informowa?a bia?oruska stra? oraz polskie media." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_67 ;
    time:dayOfWeek time:Saturday ;
    time:inXSDDate "2023-08-05"^^xsd:date .

