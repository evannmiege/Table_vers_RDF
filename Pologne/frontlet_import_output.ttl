frontlet_data:pologne_Death_69 a frontlet:Death,
        frontlet:IndividualEvent ;
    frontlet:hasDeathCause "W niedziel? (22.10) w okolicach Bia?owie?y przez dziur? wyci?t? w ogrodzeniu przesz?a grupa migrantów. Na widok polskich patroli zacz?li ucieka?. Jeden z m??czyzn utkn?? w bagnie. Polskim s?u?bom uda?o si? go wydosta? z mokrade?, ale by? bardzo wycie?czony. Zmar? przed przybyciem karetki pogotowia. M?ody m??czyzna prawdopodobnie pochodzi? z krajów Afryki, by? wychudzony i lekko ubrany - powiedzia? Polskiemu Radiu Bia?ystok szef Prokuratury Rejonowej w Hajnówce Jan Andrejczuk." ;
    frontlet:hasNarrative "W okolicach Bia?owie?y przez dziur? wyci?t? w ogrodzeniu przesz?a grupa osób. Na widok polskich patroli zacz?li ucieka?. Jeden z m??czyzn utkn?? w bagnie. Polskim s?u?bom uda?o si? go wydosta?, jednak jego stan by? bardzo ci??ki. M??czyzna zmar? w samochodzie stra?y granicznej, przed przybyciem karetki pogotowia." ;
    frontlet:sourcedBy frontlet_data:pologne_Source_69 ;
    time:dayOfWeek time:Sunday ;
    time:inXSDDate "2023-10-22"^^xsd:date .

