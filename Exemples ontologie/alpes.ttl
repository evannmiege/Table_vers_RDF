    frontlet:composedOf frontlet_data:InhumationEvent_191,
        frontlet_data:alpes_Death_gen_191 ;
    frontlet:gender thes:male ;
    frontlet:hasComment "Enterré à Sanremo le 06/07/2023",
        "Selon la presse, il se trouvait dans la région pour traverser la frontière, à intégrer dans le tableau. Nom dans liste de Charlotte Rouaoult" ;
    frontlet:hasName "Ahmed ABDULAHI" .

frontlet_data:alpes_Person_192 a frontlet:Person ;
    frontlet:aged [ a frontlet:Age ;
            frontlet:hasAge 19 ] ;
    frontlet:composedOf frontlet_data:alpes_Death_gen_192 ;
    frontlet:gender thes:male ;
    frontlet:hasComment """L'autopsie dit qu'il est mort la nuit entre le 06/07/2023 et le 07/08/2023 (https://www.ledauphine.com/faits-divers-justice/2023/08/13/le-corps-decouvert-au-gondran-est-celui-d-un-jeune-migrant-guineen). J'ai mis 07/08/2023 dans la base de données.
Il est donc mort la nuit dans laquelle il y avait il "campeggio itinerante" Passamontagna: https://www.passamontagna.info/?p=4435 (l'hypothèse qu'il est mort en échappant aux drones plausible?)
A été identifié, mais le procureur n'a pas dévoilé son nom. Le nom "Moussa" paraît dans la presse italienne: https://torino.corriere.it/notizie/cronaca/23_agosto_09/migrante-morto-a-20-anni-mentre-cercava-di-sfuggire-ai-droni-e-ai-controlli-di-frontiera-moussa-era-partito-dalla-guinea-45709e64-8876-490d-adaa-73857aeebxlk.shtml""" ;
    frontlet:hasName "Moussa" ;
    frontlet:hasOfficialName "Moussa Sidibé" .

