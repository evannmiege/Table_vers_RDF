        frontlet:IndividualEvent ;
    rdfs:label "Death event 370"@en ;
    frontlet:hasComment "Constantine, a 51-year-old Romanian man, died of a heart attack outside the Calais city train station."@en,
        "Canstantine, un homme roumain de 51 ans est décédé devant la gare de Calais ville d'un arrêt cardiaque."@fr ;
    frontlet:livedBy frontlet_data:calais_person_370 ;
