frontlet_data:calais_death_186 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 186"@en ;
    frontlet:hasComment "A train on the Dunkirk-Calais route collided with a group of around 50 migrants in the Beau Marais district of Calais. One man died and three others were injured."@en,
        "Un TER qui assurait la liaison Dunkerque-Calais a percuté un groupe d'une cinquantaine de migrants dans le quartier Beau Marais à Calais. Un homme est décédé et trois autres ont été blessés."@fr ;
    frontlet:livedBy frontlet_data:calais_person_186 ;
    frontlet:sourcedBy frontlet_data:calais_source_267,
