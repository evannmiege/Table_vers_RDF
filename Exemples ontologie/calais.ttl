    time:inXSDDate "2023-07-04"^^xsd:date .

frontlet_data:calais_death_126 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 126"@en ;
    frontlet:hasComment "Sami Ibrahim, a 25-year-old Sudanese exile, was crushed to death when he tried to climb onto a lorry. He fell and was immediately crushed by the vehicle."@en,
        "Sami Ibrahim, un exilé soudanais âgé de 25 ans, est mort écrasé en tentant de grimper sur un camion. Il a chuté et a été immédiatement écrasé par le véhicule."@fr ;
    frontlet:livedBy frontlet_data:calais_person_126 ;
    frontlet:sourcedBy frontlet_data:calais_source_198,
        frontlet_data:calais_source_199,
        frontlet_data:calais_source_200 ;
    geo:hasGeometry frontlet_data:calais_geometry_126 ;
    time:inXSDDate "2023-05-31"^^xsd:date .

frontlet_data:calais_death_127 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 127"@en ;
    frontlet:hasComment "Ahmed Youssef Adam, a 30-year-old Sudanese exile, died after being hit on the port ring road at the A26 interchange."@en,
        "Ahmed Youssef Adam, un exilé soudanais de 30 ans, est mort après avoir été percuté sur la rocade portuaire, à hauteur de l’échangeur avec l’A26."@fr ;
    frontlet:livedBy frontlet_data:calais_person_127 ;
