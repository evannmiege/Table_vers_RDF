frontlet_data:calais_death_352 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 352"@en ;
    frontlet:hasComment "An Iranian migrant in his thirties was killed when he was shot in the chest in the Marcel Doret industrial zone."@en,
        "Un exilé iranien d'une trentaine d'années a été tué d'une balle au thorax dans la zone industrielle Marcel Doret."@fr ;
