        frontlet:IndividualEvent ;
    rdfs:label "Death event 385"@en ;
    frontlet:hasComment "On the night of 15 July 2008, an Iraqi man died, hit by a heavy truck on an access flyover for the A16 motorway, not far from Calais."@en,
        "Dans la nuit du 15 juillet 2008, un homme irakien est mort, percuté par un poids lourd sur une bretelle d'accès à l'autoroute A16, non loin de Calais."@fr ;
    frontlet:livedBy frontlet_data:calais_person_385 ;
