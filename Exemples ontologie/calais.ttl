frontlet_data:calais_death_261 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 261"@en ;
    frontlet:hasComment "Raphael disappeared on 23 September 2018 after attempting, with a companion, to swim from the port to a ferry to cross the Channel. A search was unsuccessful. His body was found 10 days later."@en,
        "Avec un compagnon de route, RaphaÃ«l a tenté de passer la frontière et a essayé de monter dans un ferry en nageant à partir du port. Il est disparu le 23 septembre. Des recherches ont eu lieu, sans succès. Son corps a été découvert 10 jours plus tard."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:drowning ;
    frontlet:livedBy frontlet_data:calais_person_261 ;
    frontlet:sourcedBy frontlet_data:calais_source_366,
        frontlet_data:calais_source_367,
