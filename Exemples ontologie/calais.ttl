frontlet_data:calais_death_151 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 151"@en ;
    frontlet:hasComment "Mahmud Moussab, a 16-year-old Sudanese boy, fell between the driver's cab and the trailer of a parked truck in Marck. He was taken to hospital and died. Mahmud Moussab was buried on 27/12/2021 in the northern cemetery of Calais."@en,
        "Alors qu'il avait réussi à se positionner entre la cabine du conducteur et la remorque d'un poids lourd stationné à Marck, Mahmud Moussab, un jeune soudanais de 16 ans a chuté. Transporté à l'hôpital, il est décédé. Mahmud Moussab a été enterré le 27/12/2021 au cimetière nord de Calais."@fr ;
    frontlet:livedBy frontlet_data:calais_person_151 ;
    frontlet:sourcedBy frontlet_data:calais_source_257,
        frontlet_data:calais_source_258,
        frontlet_data:calais_source_259,
        frontlet_data:calais_source_260 ;
    geo:hasGeometry frontlet_data:calais_geometry_151 ;
    time:inXSDDate "2021-12-20"^^xsd:date .

frontlet_data:calais_death_18 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 18"@en ;
    frontlet:hasComment "Daviti Devlarishvili, a 38-year-old Georgian, was found dead in a tent at the Loon-Plage camp."@en,
        "Daviti Devlarishvili, un Géorgien de 38 ans, a été retrouvé mort dans une tente, sur le campement de Loon-Plage."@fr ;
    frontlet:livedBy frontlet_data:calais_person_18 ;
    frontlet:sourcedBy frontlet_data:calais_source_46 ;
    geo:hasGeometry frontlet_data:calais_geometry_18 ;
