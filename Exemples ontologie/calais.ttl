    time:inXSDDate "2021-10-21"^^xsd:date .

frontlet_data:calais_death_190 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 190"@en ;
    frontlet:hasComment "Yasser, a 20-year-old exile from Sudan, was found dead at around 5 a.m. on Avenue Henri-Ravisse in the Transmarck business park in Marck. The young man was hit by a lorry."@en,
        "Yasser, un exilé âgé de 20 ans et originaire du Soudan, a été retrouvé mort, aux alentours de 5 heures du matin, au niveau de l’avenue Henri-Ravisse, dans la zone d’activité Transmarck à Marck. Le jeune homme a été renversé par un poids lourd."@fr ;
    frontlet:livedBy frontlet_data:calais_person_190 ;
    frontlet:sourcedBy frontlet_data:calais_source_280,
