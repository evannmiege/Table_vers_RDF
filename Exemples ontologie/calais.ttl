    time:inXSDDate "2018-06-11"^^xsd:date .

frontlet_data:calais_death_268 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 268"@en ;
    frontlet:hasComment "On 16 May 2018, Mawda, a 2-year-old Kurdish girl, was killed by a Belgian police officer on the A24, near Mons, Belgium during a car chase. Mawda was travelling with her parents and other migrants in the back of a van."@en,
        "Le 16 mai 2018, Mawda, une fillette kurde de 2 ans, a été tuée par un policier belge lors d'une course-poursuite sur l'A42, près de Mons, en Belgique. Mawda se trouvait avec ses parents et d'autres personnes exilées dans une fourgonnette."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:homicide ;
    frontlet:livedBy frontlet_data:calais_person_268 ;
    frontlet:sourcedBy frontlet_data:calais_source_384,
        frontlet_data:calais_source_385,
        frontlet_data:calais_source_386,
        frontlet_data:calais_source_387 ;
    geo:hasGeometry frontlet_data:calais_geometry_268 ;
    time:inXSDDate "2018-05-16"^^xsd:date .

frontlet_data:calais_death_269 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 269"@en ;
    frontlet:hasComment "Mhretab, a 16-year-old Eritrean, died probably after being hit by a vehicle, on the Calais ring road. He jumped from the back of the lorry he was travelling in when he realised it was heading in the wrong direction."@en,
        "Mhretab, un exilé érythréen de 16 ans, est décédé après avoir été probablement percuté par un véhicule sur la rocade portuaire de Calais. Il aurait sauté d'un camion circulant sur la rocade portuaire de Calais, après s'être rendu compte qu'il prenait la mauvaise direction."@fr ;
    frontlet:livedBy frontlet_data:calais_person_269 ;
    frontlet:sourcedBy frontlet_data:calais_source_388,
        frontlet_data:calais_source_389 ;
    geo:hasGeometry frontlet_data:calais_geometry_269 ;
    time:inXSDDate "2018-03-28"^^xsd:date .

frontlet_data:calais_death_270 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 270"@en ;
    frontlet:hasComment "Ejaz Khan, a 25-year-old Afghani, was found dead of a knife wound on Saturday 17 March 2018 in a carpool area in Calais."@en,
        "Ejaz Khan, un jeune Afghan de 25 ans a été retrouvé mort samedi 17Â mars 2018 sur une aire de covoiturage à Calais. Le jeune homme a été tué d'un coup de couteau."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:homicide ;
    frontlet:livedBy frontlet_data:calais_person_270 ;
    frontlet:sourcedBy frontlet_data:calais_source_390,
