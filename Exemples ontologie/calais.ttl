frontlet_data:calais_death_388 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 388"@en ;
    frontlet:hasComment "In November 2006, a 40-year-old Afghan man was crushed by the truck he was hiding under in Harlow, Great Britain."@en,
        "En novembre 2006, un homme afghan âgé de 40 ans est mort écrasé par le camion sous lequel il s'était caché, à Harlow (Grande-Bretagne)."@fr ;
    frontlet:livedBy frontlet_data:calais_person_388 ;
