    rdfs:label "Death event 409"@en ;
    frontlet:hasComment "Mehdizadeh Naderi Mehrdad, 31 years old and of Iranian nationality, died in undetermined circumstances."@en,
        "Mehdizadeh Naderi Mehrdad, âgé de 31 ans et de nationalité iranienne, est mort dans des circonstances indéterminées."@fr ;
