        frontlet_data:calais_source_213,
        frontlet_data:calais_source_214 .

frontlet_data:calais_collective_event_24 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 24"@en ;
    frontlet:hasComment "On 14 October 2019, Hussein Mofaq Hussein and Soran Jamal, Iraqi Kurds from the town of Slemani, were found dead on a beach in Le Touquet, Pas-de-Calais. It is presumed that the two drowned after falling into the water while attempting to cross the Channel in a small boat."@en,
        "Hussein Mofaq Hussein et Soran Jamal Jalal, originaires de la ville de Slemani, au Kurdisatn irakien, ont été retrouvés morts, lundi 14 octobre 2019, sur une plage du Touquet, dans le Pas-de-Calais. Les deux personnes ont vraisemblablement tenté de franchir le détroit sur une embarcation et seraient décédées au cours de leur tentative après être tombées à l'eau."@fr ;
    frontlet:memberOf frontlet_data:calais_death_252,
        frontlet_data:calais_death_253 ;
    frontlet:sourcedBy frontlet_data:calais_source_337,
        frontlet_data:calais_source_338,
        frontlet_data:calais_source_339,
        frontlet_data:calais_source_340 .

frontlet_data:calais_collective_event_27 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 27"@en ;
    frontlet:hasComment "Mesfin Germa, an Ethiopian migrant,died from a hit and run on the A26 motorway near the Rely rest stop."@en,
        "Senay Berhay, a 25-year-old from Ethiopia, was found drowned in the Batellerie basin. He was living in the camp on its borders."@en,
        "Senay Berhay, exilé Ethiopien âgé de 25 ans, habitant au campement au bord du bassin de la Batellerie, a été retrouvé mort noyé dans le bassin."@fr,
        "Un exilé éthiopien, Mesfin Germa, est mort sur l'autoroute A 26 près de l'aire de repos de Rely, percuté par un véhicule. Le chauffeur ne s'est pas arrêté."@fr ;
