        frontlet:IndividualEvent ;
    rdfs:label "Death event 286"@en ;
    frontlet:hasComment "An Eritrean man was found dead in the back of a lorry, apparently suffocated after being crushed by the contents of the lorry."@en,
        "Un exilé a été retrouvé mort dans la remorque d'un camion. Il serait décédé d'asphyxie après avoir été écrasé par la cargaison."@fr ;
    frontlet:livedBy frontlet_data:calais_person_286 ;
