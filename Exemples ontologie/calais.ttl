frontlet_data:calais_death_371 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 371"@en ;
    frontlet:hasComment "Mahde Adam Ali, 28, of Sudanese nationality, died in undetermined circumstances. He was buried in the southern cemetery of Calais."@en,
        "Mahde Adam Ali, âgé de 28 ans et de nationalité soudanaise, est mort dans des circonstances indéterminées. Il a été enterré dans le cimetière sud de Calais."@fr ;
