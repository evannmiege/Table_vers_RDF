frontlet_data:calais_death_333 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 333"@en ;
    frontlet:hasComment "Mohamed Abduljabar, a Sudanese national, died in England after being crushed under the wheels of the lorry that had just brought him across the Channel, which started up as he left it."@en,
        "Mohamed Abduljabar , un exilé soudanais, meurt en Angleterre écrasé sous les roues du camion qui venait de l'emmener de l'autre côté de la Manche. Alors qu'il sortait de sous le camion, celui-ci a démarré."@fr ;
