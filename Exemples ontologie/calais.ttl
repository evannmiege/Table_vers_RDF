frontlet_data:calais_death_344 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 344"@en ;
    frontlet:hasComment "An Afghani migrant was found dead in a container which he hid in along with 34 others, on a ferry travelling from Zeebrugge to Tilbury."@en,
        "Un exilé afghan est retrouvé mort dans un container. Avec 34 autres personnes, il s'était caché dans un container qui a été chargé sur un ferry en partance de Zeebrugge et à destination de Tilbury."@fr ;
