    time:inXSDDate "2007-12-17"^^xsd:date .

frontlet_data:calais_death_387 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 387"@en ;
    frontlet:hasComment "On 7 July 2007 in Calais, Louam Beyene, a 19-year-old Eritrean woman, died after being hit by a car while she was running across the A16 motorway to escape the police. Her body was repatriated to Eritrea."@en,
        "Le 7 juillet 2007 à Calais, Louam Beyene, une femme érythréenne âgée de 19 ans, est morte, percutée par une voiture alors qu'elle traversait l'autoroute A16 en courant pour échapper à la police. Son corps a été rapatrié en Érythrée."@fr ;
    frontlet:livedBy frontlet_data:calais_person_387 ;
