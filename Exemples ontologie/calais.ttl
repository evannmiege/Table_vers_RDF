    time:inXSDDate "2025-01-11"^^xsd:date .

frontlet_data:calais_death_125 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 125"@en ;
    frontlet:hasComment "Yahya, a Sudanese exile in his twenties, died after being hit by a vehicle on the A16 motorway. According to witnesses, he fell from the trailer of a lorry he had managed to get into, and was then hit by one of the vehicles following the lorry."@en,
        "Yahya, un exilé soudanais d’une vingtaine d’années, est mort après avoir été percuté par un véhicule sur l’autoroute A16. Selon des témoins, il serait tombé de la remorque d’un camion dans lequel il avait réussi à entrer, puis aurait été percuté par l’un des véhicules qui suivaient le camion."@fr ;
    frontlet:livedBy frontlet_data:calais_person_125 ;
    frontlet:sourcedBy frontlet_data:calais_source_194,
