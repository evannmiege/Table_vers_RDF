    time:inXSDDate "2019-08-09"^^xsd:date .

frontlet_data:calais_death_256 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 256"@en ;
    frontlet:hasComment "Saeed Wllat Omar, 27, from Iraq, was housed in the Grande-Synthe gymnasium, opened by the mayor, Damien Carême. Saeed was seriously injured after being hit by a truck on the A16 near the BP gas station in Grande-Synthe on May 27, 2019. He was taken in charge by the rescue, sent to the Hospital Center of Dunkirk, then transported to Lille, to the Hospital Salengro. He remained in a coma for more than two weeks before dying on June 14. Saeed was repatriated and buried in Iraq."@en,
        "Saeed Wllat Omar, âgé de 27 ans et originaire d’Irak, était hébergé dans le gymnase de Grande-Synthe, ouvert par le maire, Damien Carême. Saeed a été gravement blessé après avoir été percuté par un camion sur l’A16, près de la station-service BP, à Grande-Synthe, le 27 mai 2019. Il a été pris en charge par les secours, envoyé au Centre Hospitalier de Dunkerque, puis transporté à Lille, à l’Hôpital Salengro. Il est resté dans le coma pendant plus de deux semaines, avant de décéder le 14 juin. Saeed a été rapatrié et enterré en Irak."@fr ;
    frontlet:livedBy frontlet_data:calais_person_256 ;
    frontlet:sourcedBy frontlet_data:calais_source_351,
        frontlet_data:calais_source_352 ;
    geo:hasGeometry frontlet_data:calais_geometry_256 ;
    time:inXSDDate "2019-06-14"^^xsd:date .

frontlet_data:calais_death_257 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 257"@en ;
    frontlet:hasComment "Mulue Debesay Gerense, a 23-year-old from Eritrea, was found dead on the Calais-bound carriageway of the A16 motorway near Dunkerque. He appears to have been hit by a car at around 11:30 pm."@en,
        "Mulue Debesay Gerense, 23 ans de nationalité érythréenne, est mort sur l'autoroute A16, dans le sens Calais vers Dunkerque. Il aurait été percuté par une voiture vers 23h30."@fr ;
    frontlet:livedBy frontlet_data:calais_person_257 ;
    frontlet:sourcedBy frontlet_data:calais_source_353,
