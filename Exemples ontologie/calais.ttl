frontlet_data:calais_death_260 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 260"@en ;
    frontlet:hasComment "Mahammat Abdullah Moussa, a 25-year-old from Chad, was found dead at Folkestone, torn to pieces on the axle of a bus that he was hiding under, which went through the Eurotunnel on a train."@en,
        "A Folkestone, Mahammat Abdullah Moussa, 25 ans et de nationalité tchadienne, été retrouvé mort alors qu'il était caché sous un bus embarqué sur un train ayant transité par l'Eurotunnel. Mahammat a été déchiqueté par l'essieu."@fr ;
    frontlet:livedBy frontlet_data:calais_person_260 ;
