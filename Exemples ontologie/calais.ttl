    time:inXSDDate "2021-09-28"^^xsd:date .

frontlet_data:calais_death_191 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 191"@en ;
    frontlet:hasComment "Michael Hermon, a 20-year-old man from Eritrea, died. The boat he was on with 36 other people capsized in the English Channel. M. was rescued and evacuated to hospital in Calais but died of cardio-respiratory arrest."@en,
        "Michael Hermon, un jeune homme de 20 ans originaire d'Érythrée, est mort. Le bateau sur lequel il se trouvait avec 36 autres personnes a chaviré dans la Manche. M. a été secouru et évacué vers l'hôpital de Calais mais est décédé d'un arrêt cardio-respiratoire."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:drowning ;
    frontlet:livedBy frontlet_data:calais_person_191 ;
