        frontlet_data:calais_source_355 ;
    geo:hasGeometry frontlet_data:calais_geometry_257 ;
    time:inXSDDate "2019-05-20"^^xsd:date .

frontlet_data:calais_death_258 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 258"@en ;
    frontlet:hasComment "Adam Ousmane Kiar, 19, died after suffering a heart attack in the back of a truck in Calais port."@en,
        "Ãégé de 19 ans, Adam Ousmane Kiar, est décédé après avoir été retrouvé en arrêt cardio-respiratoire dans la remorque d'un poids lourd stationné au port de Calais."@fr ;
