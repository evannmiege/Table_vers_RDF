frontlet_data:calais_death_140 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 140"@en ;
    frontlet:hasComment "Meretse Kahsay, a 28-year-old Ethiopian, died after being hit by a freight train. He had fallen asleep in his sleeping bag on the track. He had been living in Calais for several years and had been involved in voluntary return procedures with the French Office of Immigration and Integration (OFII) for several weeks."@en,
        "Meretse Kahsay, éthiopien de 28 ans, est mort après avoir été percuté par un train de marchandise. Il s’était endormi dans son sac de couchage sur la voie ferrée. Il vivait à Calais depuis plusieurs années et avait engagé des démarches de retour volontaire avec l'Office Français de l’Immigration et de l’Intégration (OFII) depuis plusieurs semaines."@fr ;
    frontlet:livedBy frontlet_data:calais_person_140 ;
    frontlet:sourcedBy frontlet_data:calais_source_225,
        frontlet_data:calais_source_226,
        frontlet_data:calais_source_227,
        frontlet_data:calais_source_228 ;
    geo:hasGeometry frontlet_data:calais_geometry_140 ;
    time:inXSDDate "2022-05-29"^^xsd:date .

frontlet_data:calais_death_141 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 141"@en ;
    frontlet:hasComment "Omar Faiq Twfiq, from Iraqi Kurdistan, was murdered following a shooting at the Grande-Synthe camp."@en,
        "Omar Faiq Twfiq, originaire du Kurdistan irakien, a été assassiné suite à une fusillade survenue sur le camp de Grande-Synthe."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:homicide ;
    frontlet:livedBy frontlet_data:calais_person_141 ;
