        frontlet_data:calais_source_221,
        frontlet_data:calais_source_222,
        frontlet_data:calais_source_223 ;
    geo:hasGeometry frontlet_data:calais_geometry_138 ;
    time:inXSDDate "2022-08-09"^^xsd:date .

frontlet_data:calais_death_139 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 139"@en ;
    frontlet:hasComment "An exile died after being hit by a construction truck on the departmental road 601, at the \"jungle\" on the borders of Grande-Synthe, Loon-Plage and Craywick. The person was taken care of by the emergency services, but later died in hospital."@en,
        "Un exilé est mort après avoir été percuté par un camion de chantier sur la départementale 601, au niveau la « jungle » située aux limites de Grande-Synthe, Loon-Plage et Craywick. La personne a été prise en charge par les secours, mais est décédé ensuite à l’hôpital."@fr ;
    frontlet:livedBy frontlet_data:calais_person_139 ;
    frontlet:sourcedBy frontlet_data:calais_source_220,
        frontlet_data:calais_source_224 ;
    geo:hasGeometry frontlet_data:calais_geometry_139 ;
    time:inXSDDate "2022-06-27"^^xsd:date .

frontlet_data:calais_death_14 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 14"@en ;
    frontlet:hasComment "The body of an exiled person was found on the beach of Sangatte, the day after a serious incident that caused 3 deaths and occurred in the same area."@en,
        "Le corps sans vie d’une personne exilée a été retrouvé sur la plage de Sangatte, le lendemain d’un grave incident ayant fait 3 morts et survenu dans la même zone."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:drowning ;
