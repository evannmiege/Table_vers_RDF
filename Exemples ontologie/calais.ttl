        frontlet_data:calais_source_269 ;
    geo:hasGeometry frontlet_data:calais_geometry_186 ;
    time:inXSDDate "2021-11-04"^^xsd:date .

frontlet_data:calais_death_187 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 187"@en ;
    frontlet:hasComment "A body was found on the beach of Wissant. The body is that of a young exile, possibly Sudanese. He was found on board a boat filled with water."@en,
        "Un corps a été retrouvé sur la plage de Wissant. Le corps est celui d’un jeune exilé, possiblement soudanais. Il a été retrouvé à bord d’une embarcation remplie d’eau."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:drowning ;
