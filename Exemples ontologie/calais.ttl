frontlet_data:calais_death_303 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 303"@en ;
    frontlet:hasComment "Maken Gouma, a 53-year-old Sudanese national, died in the shanty town. He was diabetic and was found dead in his tent one morning, possibly from a cardiac arrest. He is buried in the Coubertin cemetery."@en,
        "Maken Gouma, un exilé soudanais est mort dans le bidonville. Il était diabétique et a été retrouvé mort dans sa tente au matin, peut-être suite à un arrêt cardiaque. Il est enterré au cimetière de Coubertin."@fr ;
    frontlet:livedBy frontlet_data:calais_person_303 ;
    frontlet:sourcedBy frontlet_data:calais_source_439,
