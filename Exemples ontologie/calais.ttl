        frontlet:IndividualEvent ;
    rdfs:label "Death event 377"@en ;
    frontlet:hasComment "On 5 April 2009, a man was found dead in the Channel Tunnel by a maintenance team."@en,
        "Le 5 avril 2009, un homme est retrouvé mort dans le tunnel sous la Manche par une équipe de maintenance."@fr ;
