frontlet_data:calais_death_188 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 188"@en ;
    frontlet:hasComment "An migrant, possibly in her thirties, drowned when the boat in which he was trying to cross the English Channel sank off Loon-Plage."@en,
        "Un migrant, probablement âgé d'une trentaine d'années, s'est noyé lorsque le bateau dans lequel il tentait de traverser la Manche a coulé au large de Loon-Plage."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:drowning ;
