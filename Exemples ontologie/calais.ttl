        frontlet:IndividualEvent ;
    rdfs:label "Death event 398"@en ;
    frontlet:hasComment "Kazem Mustafa Amar, 26, of Iraqi nationality, died in undetermined circumstances."@en,
        "Kazem Mustafa Amar, âgé de 26 ans et de nationalité irakienne, est mort dans des circonstances indéterminées."@fr ;
