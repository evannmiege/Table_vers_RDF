frontlet_data:calais_death_189 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 189"@en ;
    frontlet:hasComment "While trying to hide in a truck, Mohammad Al Amin was hit by another truck. He was attended to by paramedics early in the morning, but died in hospital in the afternoon."@en,
        "Alors qu’il tentait de se cacher dans un camion, Mohammad Al Amin a été percuté par un autre poids lourd. Il a été pris en charge par les secours tôt le matin, mais il est décédé à l’hôpital au cours de l’après-midi."@fr ;
    frontlet:livedBy frontlet_data:calais_person_189 ;
    frontlet:sourcedBy frontlet_data:calais_source_276,
