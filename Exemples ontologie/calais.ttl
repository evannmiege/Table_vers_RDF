frontlet_data:calais_death_142 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 142"@en ;
    frontlet:hasComment "A man was found hanged in the trailer of a lorry in the Transmarck area of Marck."@en,
        "Un exilé a été retrouvé pendu dans la remorque d’un camion, au niveau de la zone Transmarck, dans la commune de Marck."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:suicide ;
    frontlet:livedBy frontlet_data:calais_person_142 ;
