        frontlet:IndividualEvent ;
    rdfs:label "Death event 351"@en ;
    frontlet:hasComment "A 26-year-old Albanian man was stabbed to death during a fight at the Epistle rest stop on the A16."@en,
        "Un albanais de 26 ans a été tué sur l'aire de repos de l'Epitre sur l'A16 par un coup de couteau mortel au cours d'une bagarre."@fr ;
    frontlet:hasDeathCause frontlet_thesaurus:homicide ;
