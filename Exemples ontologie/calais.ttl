frontlet_data:calais_death_346 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 346"@en ;
    frontlet:hasComment "Youssef Haroun, a 24-year-old from Sudan, was crushed to death by the car he was hiding under to reach England."@en,
        "Youssef Haroun, jeune exilé soudanais de 24 ans est mort écrasé par le car sous lequel il s'était accroché pour passer en Angleterre."@fr ;
