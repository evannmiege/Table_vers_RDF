        frontlet_data:calais_source_442 ;
    geo:hasGeometry frontlet_data:calais_geometry_284 ;
    time:inXSDDate "2016-12-24"^^xsd:date .

frontlet_data:calais_death_285 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 285"@en ;
    frontlet:hasComment "Mustafa Ali Bashir Mohammed, a 26-year-old Sudanese exile, died in hiding under an English bus leaving for the UK from East Station. With another Sudanese, he slipped into a trap door in the rear axle of this tourist bus returning to England. The victim’s clothes were wrapped around the axle. Mustafa Ali Bashir Mohammed was strangled when the driver returned to the road."@en,
        "Mustafa Ali Bashir Mohammed, un exilé de 26 ans de nationalité soudanaise, est mort mort caché sous un bus anglais, en partance pour le Royaume-Uni à partir de la Gare de l’Est. Avec un autre Soudanais, il s'était glissé dans une trappe au niveau de l'essieu arrière de ce bus de tourisme qui rentrait en Angleterre. Les vêtements de la victime s'étaient enroulés dans l'essieu. Mustafa Ali Bashir Mohammed a été étranglé quand le chauffeur avait repris la route."@fr ;
    frontlet:livedBy frontlet_data:calais_person_285 ;
    frontlet:sourcedBy frontlet_data:calais_source_443 ;
    geo:hasGeometry frontlet_data:calais_geometry_285 ;
    time:inXSDDate "2016-10-23"^^xsd:date .

