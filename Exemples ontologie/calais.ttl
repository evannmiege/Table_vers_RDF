frontlet_data:calais_death_259 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 259"@en ;
    frontlet:hasComment "A 26-year-old man died after being hit by a vehicle while walking along the dual carriageway between Caen and Ouistreham, near Blainville-sur-Orne, at around 8.20 in the evening of Friday 11 January 2019."@en,
        "Ce vendredi soir 11 janvier 2019, vers 20 h 20, alors qu'il marchait sur la quatre voies entre Caen et Ouistreham, un exilé de 26 ans a été percuté par un véhicule à hauteur de Blainville-sur-Orne. Il est décédé."@fr ;
    frontlet:livedBy frontlet_data:calais_person_259 ;
    frontlet:sourcedBy frontlet_data:calais_source_360,
