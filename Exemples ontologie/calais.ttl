frontlet_data:calais_death_400 a frontlet:Death,
        frontlet:IndividualEvent ;
    rdfs:label "Death event 400"@en ;
    frontlet:hasComment "On 26 October 2004, an Iraqi migrant died when hit by a heavy truck on the A16 motorway near Marck, crushed by the truck's coupling hook."@en,
        "Le 26 octobre 2004, un exilé irakien meurt renversé par un poids lourd sur l'A16 à hauteur de Marck, écrasé par l'attelage du camion."@fr ;
    frontlet:livedBy frontlet_data:calais_person_400 ;
    frontlet:sourcedBy frontlet_data:calais_source_703,
        frontlet_data:calais_source_722 ;
