frontlet_data:calais_collective_event_29 a frontlet:CollectiveEvent ;
    rdfs:label "Collective event 29"@en ;
    frontlet:hasComment "Two migrants died in a truck fire in the waiting area of the ferry terminal at Loon Plage, near Dunkerque."@en,
        "Deux personnes migrantes sont mortes dans l'incendie d'un camion dans la zone d'attente du terminal ferry à Loon Plage, près de Dunkerque."@fr ;
